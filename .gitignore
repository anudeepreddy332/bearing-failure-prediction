# pytest
.pytest_cache/

# Keep These Files (exceptions to above rules)
!.gitignore
!README.md
!LICENSE
!requirements.txt
!.env.example

# Keep Small CSVs in processed/
!data/processed/*.csv

# Keep Key Plots
!reports/feature_trends/*.png
!reports/evaluation/*.png
!reports/feature_importance.png
!reports/streamlit_dashboard/*.pdf

# Additional documentation/temp files
data/*.docx
data/*.pdf
data/*.md
data/generate_pdf.py
data/output_pipeline.pdf
data/external/

# Keep only processed CSVs
